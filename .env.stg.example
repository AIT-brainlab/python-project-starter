# Staging Environment Configuration Template (.env.stg)
# Used for pre-production / staging environment testing and QA.

PROJECT_NAME="python-project-starter"
ENVIRONMENT="stg"
BUILD_VERSION="0.1.0-rc"

SOME_API_KEY="sk-stg-placeholder"

LOG_DIR="logs/"
LOG_NAME="stg.log"
LOG_ROTATE_NAME="stg_rotate.log"
LOG_LEVEL="INFO"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=2

REDIS_URL="redis://:stgredispassword@staging-redis.internal:6379/0"

# Django settings
DJANGO_SECRET_KEY="generate-secure-secret-key-for-staging"
ALLOWED_HOSTS="staging.brainlab.ait.ac.th,localhost"
DEBUG="False"
