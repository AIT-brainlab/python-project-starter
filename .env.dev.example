# Development Environment Configuration Template (.env.dev)
# Used for local development and dev server deployments.

PROJECT_NAME="python-project-starter"
ENVIRONMENT="dev"
BUILD_VERSION="0.1.0-dev"

SOME_API_KEY="sk-dev-placeholder"

LOG_DIR="logs/"
LOG_NAME="dev.log"
LOG_ROTATE_NAME="dev_rotate.log"
LOG_LEVEL="DEBUG"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

REDIS_URL="redis://:redispassword@localhost:6379/0"

# Django settings
DJANGO_SECRET_KEY="django-insecure-dev-key-change-in-production"
ALLOWED_HOSTS="*"
DEBUG="True"
