# Production Environment Configuration Template (.env.prod)
# Used for live production server deployments (main branch).

PROJECT_NAME="python-project-starter"
ENVIRONMENT="prod"
BUILD_VERSION="1.0.0"

SOME_API_KEY="sk-prod-real-key"

LOG_DIR="logs/"
LOG_NAME="prod.log"
LOG_ROTATE_NAME="prod_rotate.log"
LOG_LEVEL="WARNING"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

REDIS_URL="redis://:strongprodpassword@prod-redis.internal:6379/0"

# Django settings
DJANGO_SECRET_KEY="generate-strong-random-secret-key-for-production"
ALLOWED_HOSTS="brainlab.ait.ac.th,api.brainlab.ait.ac.th"
DEBUG="False"
