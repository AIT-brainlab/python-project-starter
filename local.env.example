# Template env file for local development.
# Copy this to `local.env` (or `.env.dev`), then configure your secrets.
PROJECT_NAME="python-project-starter"
ENVIRONMENT="dev"
BUILD_VERSION="0.1.0-dev"

SOME_API_KEY="sk-xxxxxxxxxx"

LOG_DIR="logs/"
LOG_NAME="main.log"
LOG_ROTATE_NAME="main_rotate.log"
LOG_LEVEL="DEBUG"

FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

REDIS_URL="redis://:redispassword@redis:6379/0"

# Django settings overrides
DJANGO_SECRET_KEY="django-insecure-dev-key-change-in-production"
ALLOWED_HOSTS="*"
DEBUG="True"
